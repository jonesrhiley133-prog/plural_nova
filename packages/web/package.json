{
  "name": "@pluralnova/web",
  "version": "1.0.48",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node tools/build-sw-manifest.mjs",
    "preview": "vite preview",
    "icons": "node tools/build-icons.mjs",
    "icons:android": "node tools/build-android-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test e2e/*.test.mjs"
  },
  "dependencies": {
    "@pluralnova/shared": "*",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
