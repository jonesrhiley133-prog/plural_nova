# Copy to `.env` and edit. Every one of these has a working default, so an
# empty file is a valid configuration — this is a reference, not a checklist.
#
#   cp .env.example .env
#
# `.env` is gitignored. Nothing here is a secret today, but the session secret
# and push keys are generated into the data directory on first run, so that
# directory is the thing to back up and keep private.

# ── Where it listens ────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# Docker only: which host interface the published port binds to. Set this to
# 127.0.0.1 when Caddy, Tailscale or a tunnel is the only thing that should
# reach the app directly.
PLURALNOVA_BIND=0.0.0.0
PLURALNOVA_PORT=4000

# ── Where the data lives ────────────────────────────────────────────────────
# Database, uploads, the session secret, the push keys, and any published
# Android build. Back this up. In Docker it is a named volume mounted at /data.
PLURALNOVA_DATA_DIR=./data

# ── Serving the web client ──────────────────────────────────────────────────
# The server serves the built client from its own origin, which is what makes
# the PWA installable. Turn off only if something else serves the front end.
PLURALNOVA_SERVE_WEB=true

# Origins allowed to call the API from a browser. Same-origin — the normal
# setup — needs nothing here. Comma separated.
PLURALNOVA_CORS=

# ── HTTPS deployment ────────────────────────────────────────────────────────
# Used by docker-compose.https.yml. The hostname you will open the app at, and
# the address Let's Encrypt writes to about expiring certificates.
PLURALNOVA_DOMAIN=
PLURALNOVA_ACME_EMAIL=

# ── Email ───────────────────────────────────────────────────────────────────
# With no address set, password-reset codes come back in the API response
# instead of being emailed — convenient locally, and refused in production.
PLURALNOVA_MAIL_FROM=

# Contact address embedded in push subscriptions, per the web-push spec. Push
# services use it to reach you if your subscriptions start misbehaving.
PLURALNOVA_PUSH_CONTACT=

# ── Limits ──────────────────────────────────────────────────────────────────
PLURALNOVA_MAX_UPLOAD=26214400
PLURALNOVA_SESSION_DAYS=60
