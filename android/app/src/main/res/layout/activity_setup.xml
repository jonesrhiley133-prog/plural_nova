<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher_foreground"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/app_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_title"
            android:textColor="@color/app_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_body"
            android:textColor="@color/app_text_muted"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.35" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/field_background"
            android:hint="@string/setup_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_text_muted"
            android:textSize="15sp"
            android:autofillHints="" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/setup_connect"
            android:textAllCaps="false"
            android:textColor="@color/app_accent_text"
            android:textSize="16sp"
            android:backgroundTint="@color/app_accent" />
    </LinearLayout>
</ScrollView>
