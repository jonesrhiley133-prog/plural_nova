<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- The page draws its own safe-area padding, so it gets the whole window. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Sits over the page rather than pushing it, and only while there is
      something to say. Above the app's own bottom bar, so it never covers the
      navigation.
    -->
    <LinearLayout
        android:id="@+id/updateBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_margin="12dp"
        android:background="@drawable/update_bar_background"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/app_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/updateAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="18dp"
            android:text="@string/update_action"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/app_accent_text"
            android:backgroundTint="@color/app_accent" />

        <Button
            android:id="@+id/updateDismiss"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/update_later"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/app_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/app_background"
        android:visibility="gone"
        android:fitsSystemWindows="true">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:src="@mipmap/ic_launcher_foreground"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            android:textColor="@color/app_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:textColor="@color/app_text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingHorizontal="28dp"
            android:text="@string/error_retry"
            android:textAllCaps="false"
            android:textColor="@color/app_accent_text"
            android:backgroundTint="@color/app_accent" />

        <Button
            android:id="@+id/changeServer"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/error_change_server"
            android:textAllCaps="false"
            android:textColor="@color/app_text_muted" />
    </LinearLayout>
</FrameLayout>
