<?xml version="1.0" encoding="utf-8"?>
<!-- As backup_rules.xml: the address travels, the session and the data do not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="pluralnova.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="pluralnova.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
